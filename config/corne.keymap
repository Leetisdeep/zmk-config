#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // ENTER combo on J L K (positions 9, 10, 11)
        enter {
            bindings = <&kp ENTER>;
            key-positions = <9 10 11>;
            timeout-ms = <50>;
        };

        // Switch to Colemak DH (Layer 4) - Press U + Y
        colemak_on {
            bindings = <&to 4>;
            key-positions = <4 5>;
            timeout-ms = <50>;
        };

        // Switch to QWERTY (Layer 0) - Press I + U
        qwerty_on {
            bindings = <&to 0>;
            key-positions = <3 4>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default QWERTY
        default_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  TAB |
            // |  '   |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  | CTRL |
            // | ESC  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | ALT | BSPC| RSE |   | LWR | SPC | GUI |

            bindings = <
&mo 3  &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I  &kp O  &kp P  &kp TAB
&kp SQT  &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON  &kp LCTRL
&kp ESC  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp RIGHT_ALT  &kp BACKSPACE  &mo 2    &mo 1  &kp SPACE  &kp LGUI
            >;
        };

        // Layer 1: Lower (Numbers and arrows)
        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  TAB |
            // |      | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     | CTRL |
            // |      |     |     |     |     |     |   |     |     |     |     |     | SHFT |
            //                    | ALT | BSPC|     |   |     | SPC | GUI |

            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5        &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        // Layer 2: Raise (Symbols)
        raise_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  TAB |
            // |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  | CTRL |
            // |      |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" | SHFT |
            //                    | ALT | BSPC|     |   |     | SPC | GUI |

            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &trans
                          &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        // Layer 3: Function row
        frow {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        // Layer 4: Colemak DH Layout
        colemak_dh_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  Q  |  W  |  F  |  P  |  G  |   |  J  |  L  |  U  |  Y  |  ;  |  TAB |
            // |  '   |  A  |  R  |  S  |  T  |  D  |   |  H  |  N  |  E  |  I  |  O  | CTRL |
            // | ESC  |  Z  |  X  |  C  |  V  |  B  |   |  K  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | ALT | BSPC| RSE |   | LWR | SPC | GUI |

            bindings = <
&mo 3  &kp Q  &kp W  &kp F  &kp P  &kp G        &kp J  &kp L  &kp U  &kp Y  &kp SEMICOLON  &kp TAB
&kp SQT  &kp A  &kp R  &kp S  &kp T  &kp D        &kp H  &kp N  &kp E  &kp I  &kp O  &kp LCTRL
&kp ESC  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp K  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp RIGHT_ALT  &kp BACKSPACE  &mo 2    &mo 1  &kp SPACE  &kp LGUI
            >;
        };
    };
};
