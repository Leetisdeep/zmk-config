#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // ENTER combo on J L K (positions 9, 10, 11)
        enter {
            bindings = <&kp ENTER>;
            key-positions = <9 10 11>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default QWERTY
        default_layer {
            // Physical right half outputs QWERTY correctly
            // LETTERS ARE REVERSED to match physical layout
            // -----------------------------------------------------------------------------------------
            // | BSPC |  P  |  O  |  I  |  U  |  Y  |   |  T  |  R  |  E  |  W  |  Q  |  TAB |
            // |  '   |  ;  |  L  |  K  |  J  |  H  |   |  G  |  F  |  D  |  S  |  A  | CTRL |
            // | ESC  |  /  |  .  |  ,  |  M  |  N  |   |  B  |  V  |  C  |  X  |  Z  | SHFT |
            //                    | ALT | BSPC| RSE |   | LWR | SPC | GUI |

            bindings = <
&mo 3  &kp P  &kp O  &kp I  &kp U  &kp Y        &kp T  &kp R  &kp E  &kp W  &kp Q  &kp TAB
&kp SQT  &kp SEMICOLON  &kp L  &kp K  &kp J  &kp H        &kp G  &kp F  &kp D  &kp S  &kp A  &kp LCTRL
&kp ESC  &kp FSLH  &kp DOT  &kp COMMA  &kp M  &kp N        &kp B  &kp V  &kp C  &kp X  &kp Z  &kp LSHFT
                         &kp RIGHT_ALT  &kp BACKSPACE  &mo 2    &mo 1  &kp SPACE  &kp LGUI
            >;
        };

        // Layer 1: Lower (Numbers and arrows)
        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  0  |  9  |  8  |  7  |  6  |   |  5  |  4  |  3  |  2  |  1  |  TAB |
            // |      |     | RGT | UP  | DWN | LFT |   | BT5 | BT4 | BT3 | BT2 | BT1 | CTRL |
            // |      |     |     |     |     |     |   |     |     |     |     |     | SHFT |
            //                    | ALT | BSPC|     |   |     | SPC | GUI |

            bindings = <
&trans  &kp N0  &kp N9  &kp N8  &kp N7  &kp N6        &kp N5  &kp N4  &kp N3  &kp N2  &kp N1  &trans
&trans  &trans  &kp RIGHT  &kp UP  &kp DOWN  &kp LEFT    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        // Layer 2: Raise (Symbols)
        raise_layer {
            // -----------------------------------------------------------------------------------------
            // | BSPC |  )  |  (  |  *  |  &  |  ^  |   |  %  |  $  |  #  |  @  |  !  |  TAB |
            // |      |  \  |  ]  |  [  |  =  |  -  |   |     |     |     |     |     | CTRL |
            // |      | "|" |  }  |  {  |  +  |  _  |   |     |     |     |     |     | SHFT |
            //                    | ALT | BSPC|     |   |     | SPC | GUI |

            bindings = <
&trans  &kp RPAR  &kp LPAR  &kp ASTRK  &kp AMPS  &kp CARET    &kp PRCNT  &kp DLLR  &kp HASH  &kp AT  &kp EXCL  &trans
&trans  &kp BSLH  &kp RBKT  &kp LBKT  &kp EQUAL  &kp MINUS    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp PIPE  &kp RBRC  &kp LBRC  &kp PLUS  &kp UNDER    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        // Layer 3: Function row
        frow {
            bindings = <
&kp F11  &kp F10  &kp F9  &kp F8  &kp F7  &kp F6    &kp F5  &kp F4  &kp F3  &kp F2  &kp F1  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
